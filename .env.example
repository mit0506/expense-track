PYTHONPATH=.
FLASK_ENV=development
SECRET_KEY=change_this_to_a_secure_random_string

# Database configuration (defaults to SQLite, or configure MySQL)
DATABASE_URL=sqlite:///expense_track.db
# MySQL example: DATABASE_URL=mysql+pymysql://user:password@localhost:3306/expense_track

# Optional AI Chatbot (OpenAI API key)
OPENAI_API_KEY=sk-your-openai-api-key-goes-here